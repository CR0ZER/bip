        <GeometryDrawing Geometry="M16 11 V6.5"><GeometryDrawing.Pen><Pen Brush="#FF5D52" Thickness="1.8" StartLineCap="Flat" EndLineCap="Flat"/></GeometryDrawing.Pen></GeometryDrawing>
