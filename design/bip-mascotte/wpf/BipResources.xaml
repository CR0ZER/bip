<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Généré depuis le même modèle que les SVG. Grille 32 × 32 ; afficher dans une Image de 16, 20 ou 40 px. -->

  <!-- Couleurs d'état -->
  <Color x:Key="Bip.Waiting.Color">#FF5D52</Color>
  <Color x:Key="Bip.Running.Color">#F5A524</Color>
  <Color x:Key="Bip.Ready.Color">#3FD07F</Color>
  <Color x:Key="Bip.Error.Color">#8E96A3</Color>
  <Color x:Key="Bip.Idle.Color">#4A4A4E</Color>
  <Color x:Key="Bip.Badge.Color">#FFC93D</Color>
  <Color x:Key="Bip.Face.Color">#141414</Color>

  <!-- Interface de l'encoche -->
  <Color x:Key="Notch.Background.Color">#000000</Color>
  <Color x:Key="Notch.Card.Color">#161616</Color>
  <Color x:Key="Notch.ButtonSecondary.Color">#2A2A2A</Color>
  <Color x:Key="Notch.BorderAlways.Color">#333333</Color>
  <Color x:Key="Notch.Separator.Color">#1C1C1C</Color>
  <Color x:Key="Notch.TextPrimary.Color">#F2F2F2</Color>
  <Color x:Key="Notch.TextCode.Color">#E6E6E6</Color>
  <Color x:Key="Notch.TextSecondary.Color">#A3A3A3</Color>
  <Color x:Key="Notch.ButtonPrimary.Color">#F2F2F2</Color>
  <Color x:Key="Notch.ButtonPrimaryText.Color">#000000</Color>

  <SolidColorBrush x:Key="Bip.Waiting.Brush" Color="{StaticResource Bip.Waiting.Color}"/>
  <SolidColorBrush x:Key="Bip.Running.Brush" Color="{StaticResource Bip.Running.Color}"/>
  <SolidColorBrush x:Key="Bip.Ready.Brush" Color="{StaticResource Bip.Ready.Color}"/>
  <SolidColorBrush x:Key="Bip.Error.Brush" Color="{StaticResource Bip.Error.Color}"/>
  <SolidColorBrush x:Key="Bip.Idle.Brush" Color="{StaticResource Bip.Idle.Color}"/>
  <SolidColorBrush x:Key="Notch.Background.Brush" Color="{StaticResource Notch.Background.Color}"/>
  <SolidColorBrush x:Key="Notch.Card.Brush" Color="{StaticResource Notch.Card.Color}"/>
  <SolidColorBrush x:Key="Notch.ButtonSecondary.Brush" Color="{StaticResource Notch.ButtonSecondary.Color}"/>
  <SolidColorBrush x:Key="Notch.BorderAlways.Brush" Color="{StaticResource Notch.BorderAlways.Color}"/>
  <SolidColorBrush x:Key="Notch.Separator.Brush" Color="{StaticResource Notch.Separator.Color}"/>
  <SolidColorBrush x:Key="Notch.TextPrimary.Brush" Color="{StaticResource Notch.TextPrimary.Color}"/>
  <SolidColorBrush x:Key="Notch.TextCode.Brush" Color="{StaticResource Notch.TextCode.Color}"/>
  <SolidColorBrush x:Key="Notch.TextSecondary.Brush" Color="{StaticResource Notch.TextSecondary.Color}"/>
  <SolidColorBrush x:Key="Notch.ButtonPrimary.Brush" Color="{StaticResource Notch.ButtonPrimary.Color}"/>
  <SolidColorBrush x:Key="Notch.ButtonPrimaryText.Brush" Color="{StaticResource Notch.ButtonPrimaryText.Color}"/>

  <!-- Typographie -->
  <FontFamily x:Key="Notch.Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Notch.Font.Mono">Cascadia Mono, Consolas</FontFamily>

