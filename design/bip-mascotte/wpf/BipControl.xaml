<UserControl x:Class="ClaudeNotch.Controls.BipControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="16" Height="16"
             UseLayoutRounding="True">
    <!--
        Bip, la mascotte de ClaudeNotch. Grille 32 x 32 mise à l'échelle par le Viewbox :
        poser le contrôle à 16 (encoche repliée), 20 (liste) ou 40 px (cartes, forme entrouverte).
        Les couleurs et les mouvements sont pilotés par la propriété State dans BipControl.xaml.cs.
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Face" Color="#141414"/>
        <SolidColorBrush x:Key="FaceIdle" Color="#161616"/>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Root" Width="32" Height="32" RenderTransformOrigin="0.5,0.875" ClipToBounds="False">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RootScale"/>
                    <RotateTransform x:Name="RootTilt"/>
                    <TranslateTransform x:Name="RootShift"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Corps et pieds (Fill assigné en code : pinceau d'état animé) -->
            <Rectangle x:Name="BodyRect" Canvas.Left="7" Canvas.Top="11" Width="18" Height="14" RadiusX="4" RadiusY="4"/>
            <Rectangle x:Name="FootL" Canvas.Left="10" Canvas.Top="24" Width="4" Height="4" RadiusX="1.2" RadiusY="1.2"/>
            <Rectangle x:Name="FootR" Canvas.Left="18" Canvas.Top="24" Width="4" Height="4" RadiusX="1.2" RadiusY="1.2"/>

            <!-- Antenne droite (tous les états sauf inactif) -->
            <Canvas x:Name="AntennaStraight">
                <Path x:Name="AntennaStem" Data="M16,11 V6.5" StrokeThickness="1.8"/>
                <Ellipse x:Name="AntennaBall" Canvas.Left="13.8" Canvas.Top="2.8" Width="4.4" Height="4.4" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="AntennaBallScale"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- Antenne pliée (inactif) -->
            <Canvas x:Name="AntennaBentGroup" Opacity="0">
                <Path x:Name="AntennaBent" Data="M16,11 Q16,7.5 19.5,7.8" StrokeThickness="1.8"/>
                <Ellipse x:Name="AntennaBallBent" Canvas.Left="18.6" Canvas.Top="6" Width="4" Height="4"/>
            </Canvas>

            <!-- Bras levé (attente) -->
            <Path x:Name="Arm" Data="M24,16 L28.5,10.5" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0">
                <Path.RenderTransform>
                    <RotateTransform x:Name="ArmRotate" CenterX="24" CenterY="16"/>
                </Path.RenderTransform>
            </Path>

            <!-- Visages : un seul visible à la fois, fondu croisé de 150 ms -->
            <Canvas x:Name="FaceRunning" Opacity="0">
                <Rectangle Canvas.Left="11" Canvas.Top="16.9" Width="4" Height="2.2" RadiusX="1.1" RadiusY="1.1" Fill="{StaticResource Face}"/>
                <Rectangle Canvas.Left="17" Canvas.Top="16.9" Width="4" Height="2.2" RadiusX="1.1" RadiusY="1.1" Fill="{StaticResource Face}"/>
            </Canvas>
            <Canvas x:Name="FaceWaiting" Opacity="0">
                <Ellipse Canvas.Left="11" Canvas.Top="15" Width="4" Height="4" Fill="{StaticResource Face}"/>
                <Ellipse Canvas.Left="17" Canvas.Top="15" Width="4" Height="4" Fill="{StaticResource Face}"/>
                <Ellipse Canvas.Left="14.6" Canvas.Top="19.9" Width="2.8" Height="3.2" Fill="{StaticResource Face}"/>
            </Canvas>
            <Canvas x:Name="FaceReady" Opacity="0">
                <Path Data="M11,18.8 Q13,15.8 15,18.8" Stroke="{StaticResource Face}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M17,18.8 Q19,15.8 21,18.8" Stroke="{StaticResource Face}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M14.5,21.2 Q16,22.8 17.5,21.2" Stroke="{StaticResource Face}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
            <Canvas x:Name="FaceError" Opacity="0">
                <Rectangle Canvas.Left="11.5" Canvas.Top="17" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Face}"/>
                <Rectangle Canvas.Left="17.5" Canvas.Top="17" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Face}"/>
            </Canvas>
            <Canvas x:Name="FaceIdle" Opacity="0">
                <Path Data="M11,18 Q13,20 15,18" Stroke="{StaticResource FaceIdle}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M17,18 Q19,20 21,18" Stroke="{StaticResource FaceIdle}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>

            <!-- Pastille « ! » (erreur) -->
            <Canvas x:Name="Badge" Opacity="0">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="BadgeScale" CenterX="26" CenterY="7.5" ScaleX="0" ScaleY="0"/>
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="21.8" Canvas.Top="3.3" Width="8.4" Height="8.4" Fill="#FFC93D"/>
                <Rectangle Canvas.Left="25.3" Canvas.Top="4.8" Width="1.4" Height="3.6" RadiusX="0.7" RadiusY="0.7" Fill="{StaticResource Face}"/>
                <Ellipse Canvas.Left="25.15" Canvas.Top="9.25" Width="1.7" Height="1.7" Fill="{StaticResource Face}"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
